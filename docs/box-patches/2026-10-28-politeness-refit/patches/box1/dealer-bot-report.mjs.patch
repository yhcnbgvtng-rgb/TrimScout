+// One probe per store used to be final: a single 429 or 5xx made the store "not ready", and a brand whose few stores all had a bad
+// minute (OK Mazda: 4 stores) was dropped from the night's schedule with no log line. A 429 now waits out Retry-After (or a jittered
+// exponential backoff, capped) and a 5xx gets one jittered retry. A 403 / challenge is never retried: it is reported and the store is not ready.
+const PROBE_MAX_429_RETRIES = Number(process.env.CRAWLER_PROBE_429_RETRIES ?? 2);
+const PROBE_MAX_WAIT_MS = Number(process.env.CRAWLER_PROBE_MAX_WAIT_MS ?? 60_000);
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+async function probeWithPoliteRetry(d) {
+  let result = await probeDealer(d);
+  let n429 = 0;
+  let did5xx = false;
+  for (;;) {
+    if (result.classification === 'HTTP_429' && n429 < PROBE_MAX_429_RETRIES) {
+      const wait = Math.min(PROBE_MAX_WAIT_MS, Math.max(result.retryAfterMs ?? 0, backoffDelayMs(n429, { baseMs: 5000, capMs: PROBE_MAX_WAIT_MS })));
+      n429++;
+      process.stdout.write(`HTTP_429 — waiting ${Math.round(wait / 1000)}s${result.retryAfterMs != null ? ` (Retry-After ${Math.round(result.retryAfterMs / 1000)}s)` : ''}, retry ${n429}/${PROBE_MAX_429_RETRIES}... `);
+      await sleep(wait);
+      result = await probeDealer(d);
+    } else if (result.classification === 'HTTP_5XX' && !did5xx) {
+      did5xx = true;
+      await sleep(backoffDelayMs(0, { baseMs: 3000 }));
+      result = await probeDealer(d);
+    } else {
+      return result;
+    }
+  }
+}
