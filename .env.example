# Server-only listings keys. Never prefix these with NEXT_PUBLIC_.
# Set the real values in Vercel (or a local .env that is not committed).

# Preferred coarse listings provider (GET https://api.marketcheck.com/v2/search/car/active)
MARKETCHECK_API_KEY=

# Fallback listings provider when MarketCheck is not configured (GET https://api.auto.dev/listings)
AUTO_DEV_API_KEY=

# Optional override: marketcheck | auto.dev
# LISTINGS_PROVIDER=marketcheck
