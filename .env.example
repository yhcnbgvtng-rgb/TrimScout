# Server-only listings keys. Never prefix these with NEXT_PUBLIC_.
# Set the real values in Vercel (or a local .env that is not committed).

# Coarse listings provider (GET https://api.marketcheck.com/v2/search/car/active)
MARKETCHECK_API_KEY=

# Optional override: marketcheck
# LISTINGS_PROVIDER=marketcheck

# ---- Spike kill switches (docs/SPIKE_RUNBOOK.md). Defaults shown; flip in Vercel env, redeploy ≈ 1 min.
FEATURE_RFQ_SEND=true               # off → buyers see "quote requests are paused"; no rows written, no 500s
FEATURE_OUTBOUND_DEALER_EMAIL=true  # off → invites queue (buyer HTTP still OK); drain later with /api/ops/drain-invites
FEATURE_STICKER_FETCH=true          # off → stickers served from cache only; misses read "pending"
FEATURE_PAID_VIN_DECODE=false
FEATURE_LIVE_INVENTORY=false
OPS_SECRET=                         # header x-ops-secret for POST /api/ops/drain-invites from a shell
# Per-instance floors (hard ceiling: Vercel Firewall rate-limit rules)
# RATE_RFQ_CREATE_IP_LIMIT=20 RATE_RFQ_CREATE_IP_WINDOW_MS=600000
# RATE_INVITE_SEND_USER_LIMIT=30 RATE_SIGNUP_IP_LIMIT=5
# RATE_LIMIT_EXEMPT_ACCOUNTS=            # extra never-capped accounts (emails or ids); admins + @trimscout.test are always exempt
