  "description": "Apify Actor to crawl, track, and monitor daily VIN changes and price movements at Paul Miller Porsche.",
  "main": "src/main.js",
  "scripts": {
    "start": "node src/main.js",
    "crawl": "node src/standalone.js",
    "progress": "node src/progress_server.js",
    "dashboard": "node src/dashboard.js",
    "bot-report": "node scripts/dealer-bot-report.mjs",
    "write-nj-dealers": "node scripts/write-nj-dealer-files.mjs",
    "write-ny-dealers": "node scripts/write-ny-dealer-files.mjs",
