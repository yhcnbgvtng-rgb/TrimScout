{
  "version": "2026-10-18.1",
  "about": "Global write-time junk list for dealer_inventory_options. Applied to EVERY car, whether or not a model policy covers it. Edit patterns here (deals-api picks the file up at its next restart; OPTION_JUNK_RULES_PATH can point at another file, OPTION_JUNK_RULES=off turns the list off). Each pattern is a JavaScript regex source matched case-insensitively against the option name. A line is never dropped by this list when it is a vouched factory option: a model-policy entry (name or order code) or a make-allowlist key.",
  "rules": [
    { "name": "roadside", "patterns": ["\\broad\\s*side\\b", "\\b24\\s*[/-]?\\s*(?:hr|hour)s?\\b.{0,20}\\bassist"] },
    { "name": "inspection", "patterns": ["\\binspections?\\b", "\\b(?:multi[\\s-]*point|\\d{2,3}[\\s-]*point)\\b"] },
    { "name": "warranty", "patterns": ["\\bwarrant(?:y|ies)\\b", "\\bguarantee\\b", "\\bextended\\s+(?:service|care|protection|coverage)\\b"] },
    { "name": "maintenance-service-plan", "patterns": ["\\bmaintenance\\s+(?:plans?|packages?|programs?|coverage|services?|visits?)\\b", "\\b(?:scheduled|complimentary|prepaid|free)\\s+maintenance\\b", "\\btoyotacare\\b", "\\boil\\s+changes?\\b", "\\bservice\\s+(?:plans?|packages?|contracts?|agreements?)\\b", "\\btire\\s*(?:and|&)\\s*wheel\\s+(?:protection|plan)\\b"] },
    { "name": "subscription-trial", "patterns": ["\\bsubscriptions?\\b", "\\btrials?\\b", "\\bcomplimentary\\b", "\\bfree\\s+(?:trial|month|year|service|for)\\b", "\\b\\d+[\\s-]*(?:month|mo|year|yr)s?\\s+(?:of|free|trial|complimentary)\\b"] },
    { "name": "fee-charge", "patterns": ["\\bfees?\\b", "\\b(?:destination|delivery|freight|handling|processing|preparation|prep|documentation|doc|administration|admin|reconditioning|advertising)\\s+charges?\\b", "\\bmarket\\s+adjustment\\b", "\\badditional\\s+dealer\\s+markup\\b"] },
    { "name": "standard-or-no-charge", "patterns": ["^\\W*(?:standard|std|included|no\\s+charge|n/?c)\\W*$", "\\b(?:no|at\\s+no)\\s+(?:additional\\s+)?(?:charge|cost)\\b", "\\bstandard\\s+on\\s+(?:all|every)\\b", "\\bincluded\\s+with\\s+(?:vehicle|purchase)\\b"] },
    { "name": "dealer-ad-prose", "patterns": ["\\b(?:kbb|kelley\\s+blue|fair\\s+purchase\\s+price|priced\\s+(?:below|above|to)|market\\s+pricing|live\\s+market|subject\\s+to\\s+prior\\s+sale|prior\\s+sale|car\\s+buying\\s+process|transparent\\s+information|peace\\s+of\\s+mind|msrp|dealer\\s+(?:retail|cost|price|discount)|rebates?|incentives?|financing|apr\\b|call\\s+(?:us|now|today)|contact\\s+(?:us|the\\s+dealer)|click\\s+here|visit\\s+(?:us|our)|see\\s+(?:dealer|toyota\\.com|your|us\\b)|for\\s+details|terms\\s+and\\s+(?:limitations|conditions)|limited\\s+time|while\\s+supplies|trade[\\s-]*in|test\\s+drive|now\\s+available\\s+in|connected[\\s-]services?\\s+for|com/[\\w-]+\\s+for)\\b", "\\b(?:road\\s+trips\\s+used\\s+to\\s+be|set\\s+it\\s+and\\s+forget|meet\\s+smart\\s+car|power\\s+retail|why\\s+buy|our\\s+(?:philosophy|dealership|team))", "^\\W*(?:vehicle\\s+details|equipment|packages|summary|features|options|specifications|description|overview|inside|outside|exterior|interior|safety|performance|technology|durability|and\\s+style|audio|display/infotainment|see\\s+more|read\\s+more)\\W*$", "^\\W*(?:january|february|march|april|may|june|july|august|september|october|november|december)\\s+\\d{4}\\W*$"] },
    { "name": "vehicle-spec-not-option", "patterns": ["^\\W*\\d[dD]\\s+\\w", "^\\W*(?:awd|fwd|rwd|4wd|2wd|4x4|4x2|all[\\s-]*wheel[\\s-]*drive|four[\\s-]*wheel[\\s-]*drive|front[\\s-]*wheel[\\s-]*drive|rear[\\s-]*wheel[\\s-]*drive|4[\\s-]*wheel[\\s-]*drive)\\W*$", "^\\W*(?:\\d{1,2}[\\s-]*speed\\s+(?:automatic|manual|dct|cvt)|cvt|automatic|manual|(?:auto)?\\s*transmission)\\W*$", "^\\W*(?:black|white|gr[ae]y|silver|red|blue|beige|tan|brown|jet\\s+black|black\\s+(?:cloth|leather)|blackwall)\\W*$"] },
    { "name": "dealer-protection-appearance", "patterns": ["\\b(?:paint|fabric|leather|rust|corrosion|ceramic|clear[\\s-]*coat)\\s*(?:protection|sealant|guard|proofing|coating|treatment)\\b", "\\b(?:rust|under)\\s*(?:proof|coat)", "\\b(?:nitrogen\\s+(?:tires?|filled|fill)|vin\\s+etch|etch(?:ed|ing)?\\s+(?:vin|theft|anti)|window\\s+tint(?:ing)?|pin\\s*stripe|pinstripe|lo\\s*jack|lojack|theft\\s+(?:protection|deterrent)\\s+(?:plan|etch)|anti[\\s-]*theft\\s+(?:etch|plan)|paint\\s+protection\\s+film)\\b", "\\bdealer[\\s-]*(?:installed|added|applied|accessor(?:y|ies)|add[\\s-]*ons?)\\b", "\\(\\s*(?:lpo|dealer[\\s-]*installed)\\s*\\)"] },
    { "name": "exact-junk-labels", "patterns": ["^\\W*(?:exp|see\\s+onstar|com\\s+or\\s+dealer\\s+for\\s+details|title|creators|artists|option\\s+packages)\\W*$", "^\\W*\\d{1,2}[/.-]\\d{1,2}[/.-](?:\\d{4}|\\d{2})\\W*$"] }
  ],
  "exemptions": [
    { "name": "roadside-assistance-kit", "note": "A physical emergency kit in the car, not the roadside-assistance plan.", "patterns": ["\\broadside\\s+assistance\\s+kit\\b"] },
    { "name": "maintenance-indicators", "note": "'Shift-position and scheduled maintenance indicators' is an instrument-cluster feature, not a maintenance plan.", "patterns": ["\\bscheduled\\s+maintenance\\s+indicators?\\b"] }
  ],
  "rewrites": [
    { "name": "siriusxm-trial", "note": "SiriusXM is a real factory option; many feeds list it only as a trial-subscription line. Becomes the plain option, so the car keeps SiriusXM and the trial wording is gone. Paid extras (Extended Service, Traffic and Travel Link, protection plans) are not rewritten: they stay junk-list subscription lines.", "pattern": "^\\W*(?:\\d+[\\s-]*(?:month|year)s?\\s+)?sirius(?:xm)?\\b(?!.*\\b(?:extended|traffic|travel\\s*link|service\\s+plan|protection)\\b)[^;|]*\\b(?:trial|introductory|subscription)\\b", "to": "SiriusXM" }
  ],
  "zeroPrice": {
    "enabled": false,
    "about": "OFF until measured on live data (2026-10-16 dry run pending). When on, an explicit price of 0 is a $0 / standard / included line. A missing price (null) is unknown and is kept. Lines whose code is listed in exemptCodes carry price 0 as 'unknown, not free' (descriptionFeatures.js) and are kept.",
    "exemptCodes": ["FEATURE"]
  }
}
